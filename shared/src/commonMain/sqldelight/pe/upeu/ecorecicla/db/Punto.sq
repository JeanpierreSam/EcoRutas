-- Puntos de la ruta del dia en orden de visita.
-- omitido: 1 si el servicio registro un motivo de omision para el punto.
CREATE TABLE punto (
    id                INTEGER NOT NULL PRIMARY KEY,
    ruta_id           INTEGER NOT NULL,
    razon_social      TEXT    NOT NULL,
    direccion         TEXT    NOT NULL,
    zona              TEXT    NOT NULL,
    material_habitual TEXT    NOT NULL,
    secuencia         INTEGER NOT NULL,
    omitido           INTEGER NOT NULL DEFAULT 0
);

-- «atendido» se deriva de los pesajes locales vigentes: un pesaje hecho sin red
-- ya marca el punto como pesado, aunque el servicio todavia no lo conozca.
listarPuntos:
SELECT p.*,
       (p.omitido = 1 OR EXISTS(
            SELECT 1 FROM pesaje s
            WHERE s.punto_id = p.id AND s.ruta_id = p.ruta_id AND s.anulado = 0)) AS atendido
FROM punto p
ORDER BY p.secuencia ASC;

obtenerPunto:
SELECT p.*,
       (p.omitido = 1 OR EXISTS(
            SELECT 1 FROM pesaje s
            WHERE s.punto_id = p.id AND s.ruta_id = p.ruta_id AND s.anulado = 0)) AS atendido
FROM punto p
WHERE p.id = ?;

insertarPunto:
INSERT OR REPLACE INTO punto(id, ruta_id, razon_social, direccion, zona, material_habitual, secuencia, omitido)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

borrarPuntos:
DELETE FROM punto;
