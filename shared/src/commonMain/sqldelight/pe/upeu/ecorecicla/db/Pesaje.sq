-- Pesajes de los puntos de la ruta.
-- pendiente: 1 = el servicio aun no tiene este cambio.
--   id < 0  -> creado sin conexion (identificador local provisional)
--   id > 0  -> correccion de un pesaje existente hecha sin conexion
CREATE TABLE pesaje (
    id               INTEGER NOT NULL PRIMARY KEY,
    ruta_id          INTEGER NOT NULL,
    punto_id         INTEGER NOT NULL,
    fecha_hora       TEXT    NOT NULL,
    material         TEXT    NOT NULL,
    peso_bruto       REAL    NOT NULL,
    tara             REAL    NOT NULL,
    peso_neto        REAL    NOT NULL,
    operario         TEXT    NOT NULL,
    observacion      TEXT    NOT NULL DEFAULT '',
    anulado          INTEGER NOT NULL DEFAULT 0,
    motivo_anulacion TEXT,
    pendiente        INTEGER NOT NULL DEFAULT 0
);

listarDePunto:
SELECT * FROM pesaje WHERE punto_id = ? ORDER BY fecha_hora DESC, id DESC;

-- En el orden en que se registraron (a igual hora, el id provisional mas alto es el mas antiguo).
listarPendientes:
SELECT * FROM pesaje WHERE pendiente = 1 ORDER BY fecha_hora ASC, id DESC;

contarPendientes:
SELECT COUNT(*) FROM pesaje WHERE pendiente = 1;

obtenerPesaje:
SELECT * FROM pesaje WHERE id = ?;

guardarPesaje:
INSERT OR REPLACE INTO pesaje(id, ruta_id, punto_id, fecha_hora, material, peso_bruto, tara, peso_neto,
                              operario, observacion, anulado, motivo_anulacion, pendiente)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- La bajada no pisa una correccion local que aun no se envio.
guardarSiNoExiste:
INSERT OR IGNORE INTO pesaje(id, ruta_id, punto_id, fecha_hora, material, peso_bruto, tara, peso_neto,
                             operario, observacion, anulado, motivo_anulacion, pendiente)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0);

borrarPesaje:
DELETE FROM pesaje WHERE id = ?;

borrarSincronizados:
DELETE FROM pesaje WHERE pendiente = 0;

borrarPesajes:
DELETE FROM pesaje;

-- El servicio solo emite ids positivos: el provisional es el menor negativo menos uno.
-- MIN(0, ...) cubre la tabla vacia y la tabla con solo ids del servicio (resultado -1).
siguienteIdLocal:
SELECT MIN(0, COALESCE(MIN(id), 0)) - 1 FROM pesaje;
